#include <windows.h>
#include "colite_release.h"

IDI_ICON1 ICON "assets/colite.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COLITE_VERSION_RESOURCE
 PRODUCTVERSION COLITE_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Colite photogrammetry workbench\0"
      VALUE "FileVersion", COLITE_RELEASE_VERSION
      VALUE "InternalName", "colite_gui\0"
      VALUE "OriginalFilename", "colite_gui.exe\0"
      VALUE "ProductName", "Colite\0"
      VALUE "ProductVersion", COLITE_RELEASE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
